# Sao chép tệp này thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.

# ---------- Tài khoản nhận chuyển khoản (mã QR VietQR ở trang thanh toán) ----------
# Để trống = dùng tài khoản MẪU (số 0000000000), trang thanh toán hiện cảnh báo "tài khoản mẫu".
# Đây là thông tin NHẬN tiền in trên mã QR, không phải bí mật (tiền tố NEXT_PUBLIC_ = có trong mã trình duyệt).
# Mã BIN ngân hàng theo NAPAS, ví dụ 970436 = Vietcombank, 970418 = BIDV, 970407 = Techcombank, 970422 = MB.
NEXT_PUBLIC_BANK_BIN=
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NO=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=

# ---------- CAPTCHA ở form đăng ký (Cloudflare Turnstile) ----------
# Tạo key miễn phí: Cloudflare Dashboard → Turnstile → Add widget (thêm tên miền của website), rồi chép 2 key vào đây.
# Để trống khi chạy dev (npm run dev): website tự dùng cặp key THỬ của Cloudflare (luôn cho qua).
# Bản production (npm run build / npm run start, hoặc khi deploy) BẮT BUỘC có key thật, không thì không đăng ký được.
#   Key thử, nếu muốn ghi rõ: site key 1x00000000000000000000AA, secret key 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Khóa bí mật: CHỈ dùng ở server (src/app/api/captcha/verify/route.ts), không có tiền tố NEXT_PUBLIC_, không bao giờ commit.
TURNSTILE_SECRET_KEY=
